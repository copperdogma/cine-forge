        "content": "Noah's voice crackles over a tabletop radio."
      },
      {
        "element_type": "character",
        "content": "NOAH (RADIO)"
      },
      {
        "element_type": "dialogue",
        "content": "East road is open one lane. Bridge crew wants no heavy trucks till daylight."
      },
      {
        "element_type": "action",
        "content": "June writes the update beneath NORTH SHELTER on the whiteboard, then takes Maya's flyer."
      },
      {
        "element_type": "character",
        "content": "JUNE"
      },
      {
        "element_type": "dialogue",
        "content": "Spell his name for the broadcast."
