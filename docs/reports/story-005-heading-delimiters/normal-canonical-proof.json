        "content": "KELL"
      },
      {
        "element_type": "dialogue",
        "content": "Comet better be worth interrupting the weather report."
      },
      {
        "element_type": "character",
        "content": "MAYA"
      },
      {
        "element_type": "dialogue",
        "content": "He stole my grilled cheese and slept through the evacuation. He's family."
      },
      {
