        "props_mentioned": [],
        "elements": [
          {
            "element_type": "scene_heading",
            "content": "INT. HIGH SCHOOL GYM SHELTER - PRE-DAWN"
          },
          {
            "element_type": "action",
            "content": "Cots line the basketball court. Handwritten signs point toward MEDICINE, MEALS, and MESSAGES."
          },
          {
            "element_type": "action",
            "content": "June records updates at a folding table while Kell sorts flashlight batteries into a tackle box."
          },
          {
            "element_type": "action",
            "content": "MAYA, a teenager in a soaked marching-band jacket, approaches with a flyer for a missing dog named COMET."
          },
          {
            "element_type": "character",
            "content": "MAYA"
          },
          {
            "element_type": "dialogue",
            "content": "Can the station announce this too?"
          },
          {
            "element_type": "character",
            "content": "JUNE"
          },
          {
            "element_type": "dialogue",
            "content": "If we're naming roads and insulin drops, we can name dogs."
          },
          {
            "element_type": "character",
            "content": "KELL"
          },
          {
            "element_type": "dialogue",
            "content": "Comet better be worth interrupting the weather report."
          },
          {
            "element_type": "character",
            "content": "MAYA"
          },
          {
            "element_type": "dialogue",
            "content": "He stole my grilled cheese and slept through the evacuation. He's family."
          },
          {
            "element_type": "action",
            "content": "Noah's voice crackles over a tabletop radio."
          },
          {
            "element_type": "character",
            "content": "NOAH (RADIO)"
          },
          {
            "element_type": "dialogue",
            "content": "East road is open one lane. Bridge crew wants no heavy trucks till daylight."
          },
          {
            "element_type": "action",
            "content": "June writes the update beneath NORTH SHELTER on the whiteboard, then takes Maya's flyer."
          },
          {
            "element_type": "character",
            "content": "JUNE"
          },
          {
            "element_type": "dialogue",
            "content": "Spell his name for the broadcast."
          },
          {
            "element_type": "character",
            "content": "MAYA"
          },
          {
            "element_type": "dialogue",
            "content": "C-O-M-E-T. Like the fast kind of star."
          },
          {
            "element_type": "transition",
            "content": "CUT TO:"
          }
