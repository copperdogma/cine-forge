        "elements": [
          {
            "element_type": "scene_heading",
            "content": "INT. COMMUNITY RADIO STUDIO - NIGHT"
          },
          {
            "element_type": "action",
            "content": "Rain rattles the skylight. Old consoles hum under emergency power."
          },
          {
            "element_type": "action",
            "content": "ARIA threads a tape reel while NOAH coaxes a signal out of a battered mixer."
          },
          {
            "element_type": "action",
            "content": "JUNE covers a whiteboard with road closures, shelter names, and call signs."
          },
          {
            "element_type": "action",
            "content": "KELL rushes in carrying a portable antenna, a dented lantern, and a canvas tool bag."
          },
          {
            "element_type": "character",
            "content": "KELL"
          },
          {
            "element_type": "dialogue",
            "content": "Bridge is closed. Cell towers are dead. The hill relay is our only shot."
          },
          {
            "element_type": "character",
            "content": "NOAH"
          },
          {
            "element_type": "dialogue",
            "content": "Please tell me that antenna is less cursed than it looks."
          },
          {
            "element_type": "character",
            "content": "KELL"
          },
          {
            "element_type": "dialogue",
            "content": "It only tried to kill me once."
          },
          {
            "element_type": "character",
            "content": "JUNE"
          },
          {
            "element_type": "dialogue",
            "content": "Good. Tonight we don't have time for a second opinion."
          },
          {
            "element_type": "action",
            "content": "Aria flips a switch. The ON AIR sign flickers, then dies again."
          },
          {
            "element_type": "character",
            "content": "ARIA"
          },
          {
            "element_type": "dialogue",
            "content": "Give me ten minutes and one miracle."
          },
          {
            "element_type": "character",
            "content": "JUNE"
          },
          {
            "element_type": "dialogue",
            "content": "Take fifteen. Keep the miracle."
          },
          {
            "element_type": "transition",
            "content": "CUT TO:"
          }
        ],
