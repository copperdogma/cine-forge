        "elements": [
          {
            "element_type": "scene_heading",
            "content": "EXT. WATER TOWER CATWALK - NIGHT"
          },
          {
            "element_type": "action",
            "content": "Wind lashes the catwalk. The town below is mostly dark except for the high school gym and a gas station canopy."
          },
          {
            "element_type": "action",
            "content": "Aria braces the lantern with her boot while Noah clamps the portable antenna to a rusted rail."
          },
          {
            "element_type": "action",
            "content": "The canvas tool bag swings in the gusts. Somewhere in the valley, a siren rises and cuts out."
          },
          {
            "element_type": "character",
            "content": "NOAH"
          },
          {
            "element_type": "dialogue",
            "content": "I miss boring weather."
          },
          {
            "element_type": "character",
            "content": "ARIA"
          },
          {
            "element_type": "dialogue",
            "content": "You miss boring jobs."
          },
          {
            "element_type": "action",
            "content": "Noah plugs the cable into a handheld receiver. Static spits, then settles into a thin human voice."
          },
          {
            "element_type": "character",
            "content": "UNKNOWN VOICE (RADIO)"
          },
          {
            "element_type": "dialogue",
            "content": "Red Creek station... if anyone hears this... north shelter needs insulin and dry blankets."
          },
          {
            "element_type": "action",
            "content": "Aria and Noah freeze."
          },
          {
            "element_type": "character",
            "content": "ARIA"
          },
          {
            "element_type": "dialogue",
            "content": "June, do you copy?"
          },
          {
            "element_type": "character",
            "content": "JUNE (RADIO)"
          },
          {
            "element_type": "dialogue",
            "content": "Loud enough to make me useful."
          },
          {
            "element_type": "action",
            "content": "Aria smiles for the first time all night and tightens the last bolt."
          },
          {
            "element_type": "transition",
            "content": "CUT TO:"
          }
