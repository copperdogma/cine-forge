        "props_mentioned": [],
        "elements": [
          {
            "element_type": "scene_heading",
            "content": "INT. COMMUNITY RADIO STUDIO - MORNING"
          },
          {
            "element_type": "action",
            "content": "Wet coats hang from every chair. Pale sunlight cuts through the storm residue on the windows."
          },
          {
            "element_type": "action",
            "content": "Aria pins a hand-drawn map beside the console. Noah labels a notebook DAY TWO."
          },
          {
            "element_type": "action",
            "content": "June tapes a new sign over the door: OPEN FREQUENCY."
          },
          {
            "element_type": "action",
            "content": "Kell enters with a loaf of warm bread wrapped in foil. Maya follows close behind with a muddy, sleepy COMET in her arms."
          },
          {
            "element_type": "character",
            "content": "MAYA"
          },
          {
            "element_type": "dialogue",
            "content": "He was under the vending machine in the band room."
          },
          {
            "element_type": "character",
            "content": "KELL"
          },
          {
            "element_type": "dialogue",
            "content": "Smart dog. Dry floor, free snacks."
          },
          {
            "element_type": "action",
            "content": "June laughs, reaches for the microphone, and nods at Aria."
          },
          {
            "element_type": "character",
            "content": "JUNE"
          },
          {
            "element_type": "dialogue",
            "content": "Red Creek, morning bulletin. East road is open, north shelter is stocked, and one missing dog has been recovered with zero remorse."
          },
          {
            "element_type": "action",
            "content": "Noah pushes up a brass-heavy cassette cue. The room brightens with music."
          },
          {
            "element_type": "character",
            "content": "ARIA"
          },
          {
            "element_type": "dialogue",
            "content": "Put that on repeat between updates."
          },
          {
            "element_type": "character",
            "content": "JUNE"
          },
          {
            "element_type": "dialogue",
            "content": "No. Once is joy. Twice is branding."
          },
          {
            "element_type": "action",
            "content": "The ON AIR sign steadies into a solid red glow as the four of them settle back to work."
          }
        ],
